{
  "name": "jop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local wardrobe and purchase-history app to help you pause before an impulse purchase.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "test": "node --test tests/*.test.js",
    "check:privacy": "python3 scripts/check_public.py",
    "release:public": "python3 scripts/prepare_release.py"
  }
}
